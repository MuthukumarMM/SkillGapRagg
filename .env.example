# GEMINI_API_KEY: Required on the Express server (server.ts) for Gemini AI calls:
# - Resume skill extraction & advisory explanations (gemini-3.8-flash)
# - RAG semantic chunk & query embeddings (gemini-embedding-2-preview)
# In AI Studio, configure or verify this secret via Settings > Secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Base URL where this application is hosted.
APP_URL="http://localhost:3000"

# GITHUB_TOKEN: Optional GitHub Personal Access Token (repo / contents:write scope)
# Configure in Settings > Secrets if pushing directly from the cloud workspace to GitHub.
GITHUB_TOKEN=""
